<?xml version="1.0" encoding="utf-8"?>
<!-- 启动画面背景(Android 11 及以下走 windowBackground):深底 + 居中看板字形。
     Android 12+ 改用 SplashScreen API(见 values-v31/themes.xml)。 -->
